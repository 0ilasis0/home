{
  "$schema": "https://opencode.ai/config.json",

  // 預設由 Orchestrator 接收使用者任務
  "default_agent": "orchestrator",

  // V2 原生設定：Primary Agent 可委派給 Specialist，
  // Specialist 不可再向下委派
  "subagent_depth": 1,

  // V2 原生 Provider 設定 - 使用免費雲端模型
  "provider": {
    "opencode": {
      "name": "OpenCode Cloud (Free)",

      // 免費雲端模型（input/output/cache 皆為 0）
      "models": {
        "longcat-2.5-preview-free": {
          "name": "LongCat 2.5 Preview - Orchestrator"
        },
        "deepseek-v4.1-flash-free": {
          "name": "DeepSeek V4.1 Flash - Coding & Integration"
        },
        "mimo-v2.6-flash-free": {
          "name": "MiMo V2.6 Flash - Research"
        },
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash - Reviewer"
        }
      }
    }
  }
}
