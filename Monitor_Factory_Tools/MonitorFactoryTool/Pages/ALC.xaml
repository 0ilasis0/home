<Page x:Class="MonitorFactoryTool.ALC"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MonitorFactoryTool"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ALC" Loaded="Page_Loaded">

    <Grid>
        <Grid Background="White" HorizontalAlignment="Left" Width="800" VerticalAlignment="Stretch" ShowGridLines="True" >
            <Grid.RowDefinitions>
                <RowDefinition Height="160" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid x:Name="Function" Grid.Row="0">
                <Label x:Name="labelALCConnect" Content="ALC Connect:" Margin="10,2,700,123"/>
                <Label x:Name="labelALCYes" Content="No" Margin="100,3,670,123"/>
                <Button x:Name ="buttonALCConnect" Content="Connect" Margin="135,7,606,136" Click="buttonALCConnect_Click"/>
                <Label x:Name="labelModelName" Content="Model Name:" Margin="10,32,700,102"/>
                <Label x:Name="labelALCModelName" Content="XXXXX" Margin="100,32,600,100"/>
                
                <Button x:Name ="buttonSTMTest" Content="STM32 Test Brightness" Margin="500,7,106,136" Click="buttonSTMTest_Click"/>
                
                <Label x:Name="labelPanelName" Content="Panel Name" Margin="210,2,510,123"/>
                <Label x:Name="labelPanelSpec" Content="Panel Spec" Margin="210,32,510,0"  VerticalAlignment="Top"/>
                <Label x:Name="labelDiffRate" Content="Diff Rate" Margin="424,32,296,102" >
                  
                 
                </Label>
                <Label x:Name="lableCorrect" Content="Correct" Margin="424,60,324,0" VerticalAlignment="Top"/>
                <Label x:Name="labelCorrectYes" Content="No" Margin="483,60,277,0" VerticalAlignment="Top"/>

                <Label x:Name="labelOverTimes" Content="Over Times:" Margin="424,88,296,0" VerticalAlignment="Top"/>
                <Label x:Name="labelOverTimesCount" Content="0" Margin="510,88,235,0" VerticalAlignment="Top"/>


                <TextBox x:Name="textBoxPanelName" Text="AUOG215" Margin="334,5,378,0" VerticalAlignment="Top"/>
                <TextBox x:Name="textBoxPanelSpec" Text="300nits" Margin="334,36,378,0" VerticalAlignment="Top"/>
                <TextBox x:Name="textBoxDiffRate" Text="5%" Margin="527,36,210,0" VerticalAlignment="Top"/>
                <Button x:Name ="buttonCorrect" Content="Correct" Margin="533,64,195,0" VerticalAlignment="Top" Click="buttonCorrect_Click" IsEnabled="False"/>

                <TextBlock x:Name="textBlockModule" Text="Sensor:"  Margin="429,120,251,0" VerticalAlignment="Top"/>


                <GroupBox Header="Connection" Margin="10,62,704,5">
                    <StackPanel>
                        <RadioButton x:Name ="RadiobuttonInternal" Content="Internal" GroupName="ConnectionMode"  Margin="0,10,0,0" VerticalAlignment="Top" FontSize="15" />
                        <RadioButton x:Name ="RadiobuttonExternal" Content="External" GroupName="ConnectionMode"   Margin="0,10,0,0" VerticalAlignment="Top" FontSize="15" />
                    </StackPanel>
                </GroupBox>





                <GroupBox Header="ALC Func" Margin="100,62,628,5">
                    <StackPanel>
                        <RadioButton x:Name ="RadiobuttonON" Content="On" GroupName="ALCFunc"  Margin="0,10,0,0" VerticalAlignment="Top" FontSize="15" Click="buttonOn_Click"/>
                        <RadioButton x:Name ="RadiobuttonOFf" Content="Off" GroupName="ALCFunc"   Margin="0,10,0,0" VerticalAlignment="Top" FontSize="15" Click="buttonOff_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox BorderThickness="1" BorderBrush="gray" Margin="176,62,378,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <!-- Model  -->
                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                            <!-- RadioButtons -->
                            <ColumnDefinition/>
                            <!-- TextBox -->
                        </Grid.ColumnDefinitions>

                        <Label x:Name="labelMode" Content="Mode:" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>

                        <RadioButton x:Name="buttonALC1" Content="ALC1" GroupName="ALCMode" FontSize="15" Checked="ALCMode_Checked" Grid.Column="1"  Margin="0,6,0,64"/>
                        <TextBox x:Name="textBoxALC1Data" Text="120" FontWeight="Bold" Grid.Column="2" Margin="15,6,50,64"/>

                        <RadioButton x:Name="buttonALC2" Content="ALC2" GroupName="ALCMode" FontSize="15" Checked="ALCMode_Checked"   Grid.Column="1"  Margin="0,22,0,48"/>
                        <TextBox x:Name="textBoxALC2Data" Text="150" FontWeight="Bold"  Grid.Column="2" Margin="15,22,50,48"/>

                        <RadioButton x:Name="buttonALC3" Content="ALC3" GroupName="ALCMode" FontSize="15" Checked="ALCMode_Checked"  Grid.Column="1"  Margin="0,38,0,32"/>
                        <TextBox x:Name="textBoxALC3Data" Text="200" FontWeight="Bold"  Grid.Column="2" Margin="15,38,50,32"/>

                        <RadioButton x:Name="buttonALC4" Content="ALC4" GroupName="ALCMode" FontSize="15" Checked="ALCMode_Checked"   Grid.Column="1"  Margin="0,54,0,16" />
                        <TextBox x:Name="textBoxALC4Data" Text="250" FontWeight="Bold"  Grid.Column="2" Margin="15,54,50,16"/>

                        <RadioButton x:Name="buttonALC5" Content="ALC5" GroupName="ALCMode" FontSize="15" Checked="ALCMode_Checked"  Grid.Column="1"  Margin="0,70,12,0"/>
                        <TextBox x:Name="textBoxALC5Data" Text="300" FontWeight="Bold" Grid.Column="2" Margin="15,70,50,0"/>
                    </Grid>
                </GroupBox>

            </Grid>
            <Grid x:Name="Content" Grid.Row="1" >
                <ListBox x:Name="listBoxTempLum" SelectionMode="Extended" Margin="10,10,400,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Time}" Margin="5" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Temperature}" Margin="5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Luminance}" Margin="5" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Margin="5" HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Over">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="listBoxCenterCorner" SelectionMode="Extended" Margin="420,10,10,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Descript}" Margin="5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Center}" Margin="5" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="{Binding Corner}" Margin="5" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="3" Text="{Binding Difference}" Margin="5" HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
            <Grid x:Name="File" Grid.Row="2">
                <Button x:Name ="buttonListExport" Content="ListExport" Margin="10,10,400,10" Click="buttonListExport_Click"/>
                <Button x:Name ="buttonCorrectExport" Content="CorrectExport" Margin="420,10,10,10" Click="buttonCorrectExport_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
