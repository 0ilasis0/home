<Page x:Class="MonitorFactoryTool.Pages.Factory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MonitorFactoryTool.Pages"
      xmlns:localgrid="clr-namespace:MonitorFactoryTool.FactoryGrid"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="Factory" Width="700">

    <Grid Height="450" VerticalAlignment="Top">


        <Grid Background="white" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="700" Height="450" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="330" />
                <RowDefinition Height="120" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,0">
                <WrapPanel x:Name="FactoryWrapPanel" Orientation="Vertical" Grid.Column="0"   Background="Transparent" Margin="0,0,0,-120" >
                    <Grid x:Name="CommandList" ShowGridLines="True" Height="350" Width="700" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="gridIndex0"  Grid.Row="0" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex1" Grid.Row="1" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown" >
                        </Grid>

                        <Grid x:Name="gridIndex2" Grid.Row="2" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex3" Grid.Row="3" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex4" Grid.Row="4" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex5" Grid.Row="5" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex6" Grid.Row="6" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown" >
                        </Grid>

                        <Grid x:Name="gridIndex7" Grid.Row="7" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex8" Grid.Row="8" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex9" Grid.Row="9" Grid.Column="0" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex10" Grid.Row="0" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown" >
                        </Grid>

                        <Grid x:Name="gridIndex11" Grid.Row="1" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex12" Grid.Row="2" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex13" Grid.Row="3" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex14" Grid.Row="4" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex15" Grid.Row="5" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex16" Grid.Row="6" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex17" Grid.Row="7" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex18" Grid.Row="8" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>

                        <Grid x:Name="gridIndex19" Grid.Row="9" Grid.Column="1" ShowGridLines="True" Background ="Transparent" MouseDown="Grid_MouseDown">
                        </Grid>
                    </Grid>

                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Button x:Name="buttonSet" Content="Set" Margin="130,22,0,78" HorizontalAlignment="Left" Width="60" Height="20" Click="buttonSet_Click"/>
                <Button x:Name="buttonGet" Content="Get" Margin="230,22,0,78" HorizontalAlignment="Left" Width="60" Height="20" Click="buttonGet_Click"/>
                <Button x:Name="buttonRemove" Content="Remove" Margin="30,58,0,42" HorizontalAlignment="Left" Width="60" Height="20" Click="buttonRemove_Click"/>
                <Button x:Name="buttonLoop" Content="Loop" Margin="130,58,0,42" HorizontalAlignment="Left" Width="60" Height="20" Click="buttonLoop_Click" />
                <Button x:Name="buttonReload" Content="Reload" Margin="230,58,0,42" HorizontalAlignment="Left" Width="60" Height="20" />
                <Button x:Name="buttonAdd" Content="Add" Margin="30,22,0,78" HorizontalAlignment="Left" Width="60" Height="20" Click="buttonAdd_Click"/>
                <Button x:Name="buttonMoveUp" Content="Up" Margin="0,22,0,78" HorizontalAlignment="Center" Width="60" Height="20" Click="buttonMoveUp_Click" />
                <Button x:Name="buttonMoveDown" Content="Down" Margin="0,58,0,42" HorizontalAlignment="Center" Width="60" Height="20" Click="buttonMoveDown_Click"  />

                <Button x:Name="buttonSaveScript" Content="Save Script" Margin="421,57,0,42" HorizontalAlignment="Left" Width="75" Height="20" Click="buttonSaveScript_Click" />
                <Button x:Name="buttonLoadScript" Content="Load Script" Margin="421,89,0,11" HorizontalAlignment="Left" Width="75" Height="20" Click="buttonLoadScript_Click"  />

                <Label x:Name="labelRunTimes" Content="Run Times:" Margin="535,16,0,80"  HorizontalAlignment="Left" Width="74"/>
                <Label x:Name="labelRunTimesCount" Content="0" Margin="610,16,0,80"  HorizontalAlignment="Left" Width="60"  />

                <TextBox x:Name="textBoxRepeatCount" Text="5" Margin="540,50,0,0" VerticalAlignment="Top"  HorizontalAlignment="Left" Width="46"  />
                <CheckBox x:Name="clickRepeatCount" Content="times to run" Margin="597,50,0,48"  HorizontalAlignment="Left" Width="90" Height="20" Checked="clickRepeatCount_Checked"/>

                <CheckBox x:Name="clickMCCSmode" Content="MCCS mode" Margin="230,22,0,78"  HorizontalAlignment="Center" Width="90" Height="20" Grid.Column="1" Click="clickMCCSmode_Checked"/>
            </Grid>
        </Grid>




    </Grid>
</Page>
