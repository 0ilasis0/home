<Page x:Class="MonitorFactoryTool.Pages.Calibration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MonitorFactoryTool.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Calibration">

    <Page.Resources>
        <Style x:Key="JudgeLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="PASS">
                    <Setter Property="Foreground" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="FAIL">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>



    <Grid>
        <Grid Background="White" HorizontalAlignment="Left" Width="800" VerticalAlignment="Stretch" ShowGridLines="True" >
            <Grid.RowDefinitions>
                <RowDefinition Height="140" />
                <RowDefinition />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid x:Name="Function" Grid.Row="0">

                <Label x:Name="labelModelName" Content="Model Name" Margin="10,10,700,0" VerticalAlignment="Top"/>
                <Label x:Name="labelModelNameContent" Content="XXXXX" Margin="120,10,588,0" VerticalAlignment="Top"/>
                <Label x:Name="labelPanelName" Content="Panel Name" Margin="10,40,700,0"  VerticalAlignment="Top"/>
                <TextBox x:Name="textBoxModelName" Text="AUOG215" Margin="121,44,584,0" VerticalAlignment="Top"/>
                <Label x:Name="labelPanelContrast" Content="Contrast: " Margin="225,40,509,0"  VerticalAlignment="Top"/>
                <TextBox x:Name="textBoxPanelContrastInfo" Text="1000" Margin="285,44,469,0"  VerticalAlignment="Top"/>
                <Label x:Name="labelDate" Content="Date" Margin="10,72,712,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelDateContent" Content="2025/2/10 14:47" Margin="120,71,575,00"  VerticalAlignment="Top"/>
                <Label x:Name="labelAmbientLight" Content="Ambient" Margin="225,72,516,0"  VerticalAlignment="Top"/>
                <TextBox x:Name="textBoxAmbientLight" Text="0.0" Margin="285,76,469,0"  VerticalAlignment="Top" />

                <Button x:Name="buttonVerify" Content="Verify Start" Margin="16,105,688,0" VerticalAlignment="Top"  Height="21" Click="buttonVerify_Click"/>
                <Button x:Name="buttonCalibration" Content="Calibration Start" Margin="157,105,527,0" VerticalAlignment="Top"  Height="21" Click="buttonCalibration_Click"/>

                <Label x:Name="labelContrast" Content="Contrast" Margin="346,10,359,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelContrastJudge" Content="N/A" Margin="466,10,294,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxContrast" Text="N/A" Margin="511,15,229,0" Width="60" VerticalAlignment="Top"/>

                <Label x:Name="labelUniformity" Content="Uniformity" Margin="346,32,359,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelUniformityJudge" Content="N/A" Margin="466,32,294,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxUniformity" Text="N/A" Margin="511,36,229,0"  Width="60" VerticalAlignment="Top"/>

                <Label x:Name="labelColorTemp1" Content="Color Temp 1" Margin="346,54,335,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelColorTemp1Judge" Content="N/A" Margin="466,54,276,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxColorTemp1" Text="N/A" Margin="511,58,229,0"  Width="60" VerticalAlignment="Top"/>

                <Label x:Name="labelColorTemp2" Content="Color Temp 2" Margin="346,77,334,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelColorTemp2Judge" Content="N/A" Margin="466,77,291,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxColorTemp2" Text="N/A" Margin="511,81,229,0"  Width="60" VerticalAlignment="Top"/>

                <Label x:Name="labelColorTemp3" Content="Color Temp 3" Margin="346,100,335,0"  VerticalAlignment="Top"/>
                <Label x:Name="labelColorTemp3Judge" Content="N/A" Margin="466,100,291,0"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}" />
                <TextBox x:Name="textBoxColorTemp3" Text="N/A" Margin="511,104,229,0"  Width="60" VerticalAlignment="Top"/>


                <Label x:Name="labelGamma1" Content="Gamma 1" Margin="587,10,134,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelGamma1Judge" Content="N/A" Margin="680,10,77,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxGamma1" Text="N/A" Margin="751,14,2,0" VerticalAlignment="Top" />

                <Label x:Name="labelGamma2" Content="Gamma 2" Margin="587,32,134,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelGamma2Judge" Content="N/A" Margin="680,32,77,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxGamma2" Text="N/A" Margin="751,36,2,0" VerticalAlignment="Top"/>

                <Label x:Name="labelGamma3" Content="Gamma 3" Margin="587,54,134,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelGamma3Judge" Content="N/A" Margin="680,54,77,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxGamma3" Text="N/A" Margin="751,58,2,0" VerticalAlignment="Top"/>

                <Label x:Name="labelGamma4" Content="Gamma 4" Margin="587,77,134,20"  VerticalAlignment="Top"/>
                <Label x:Name="labelGamma4Judge" Content="N/A" Margin="680,77,77,20"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxGamma4" Text="N/A" Margin="751,81,2,0" VerticalAlignment="Top"/>

                <Label x:Name="labelDICOM" Content="DICOM" Margin="587,100,112,0"  VerticalAlignment="Top"/>
                <Label x:Name="labelDICOMJudge" Content="N/A" Margin="680,100,67,0"  VerticalAlignment="Top"  Style="{StaticResource JudgeLabelStyle}"/>
                <TextBox x:Name="textBoxDICOM" Text="N/A" Margin="751,104,2,0" VerticalAlignment="Top"/>

            </Grid>
            <Grid x:Name="Content" Grid.Row="1" >
                <ListBox x:Name="listBoxCalibration" SelectionMode="Extended" Margin="10,10,10,10">
                    <!--<ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Time}" Margin="5" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Temperature}" Margin="5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Luminance}" Margin="5" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="3" Text="{Binding Status}" Margin="5" HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Over">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>-->
                </ListBox>

            </Grid>

            <Grid x:Name="File" Grid.Row="2">
                <Button x:Name ="buttonCALListExport" Content="ListExport" Margin="10,10,400,10" Click="buttonListExport_Click"/>
                <Button x:Name ="buttonCALSampleVerificationExport" Content="Sample Verification Record Export" Margin="420,10,10,10" Click="buttonCALSampleVerificationExport_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
