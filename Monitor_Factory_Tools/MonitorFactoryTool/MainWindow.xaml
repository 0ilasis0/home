<Window x:Class="MonitorFactoryTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonitorFactoryTool"
        xmlns:localgrid="clr-namespace:MonitorFactoryTool.FactoryGrid"
        mc:Ignorable="d"
        Title="Onyx Monitor Factory Tool V0.12C" Height="550" Width="1200" MinHeight="550" MinWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" HorizontalAlignment="Left" >

            <TextBlock x:Name="textBlockModelInfo" Text="Model Information" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" FontSize="15"/>
            <Grid x:Name="gridModelInfo" Width="254" Height="170" Margin="10,34,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="5" Margin="0,0,0,0" />
                <ComboBox x:Name="comboModelPort" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Width="139"  DropDownOpened="comboModelPort_DropDownOpened" DropDownClosed="comboModelPort_DropDownClosed" Loaded="comboModelPort_Loaded"/>
                <TextBlock x:Name="textBlockModelPortRate" Text="Rate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,41,0,0"/>
                <ComboBox x:Name="comboModelPortRate" Margin="39,39,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Width="110" DropDownOpened="comboModelPortRate_DropDownOpened" DropDownClosed="comboModelPortRate_DropDownClosed" Loaded="comboModelPortRate_Loaded"/>
                <Button x:Name="buttonModelConnect" Margin="154,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="50" Content="Connect" Click="buttonModelConnect_Click"/>
                <TextBlock x:Name="textBlockModelModleName" Text="Modle Name:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,75,0,0"/>
                <TextBox x:Name="textBoxModelSerialNumber" Text="NA" FontWeight="Bold" Width="128" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="116,73,0,0" />
                <TextBlock x:Name="textBlockModelFirmwareVersion" Text="Firmware Version:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,105,0,0"/>
                <TextBox x:Name="textBoxModelFirmwareVersion" Text="NA" FontWeight="Bold" Width="128" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="116,103,0,0" />
                <TextBlock x:Name="textBlockModelInputSource" Text="Input Source:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,135,0,0"/>
                <TextBox x:Name="textBoxModelInputSource" Text="NA" FontWeight="Bold" Width="129" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="116,133,0,0"/>
            </Grid>

            <TextBlock x:Name="textBlockCommand" Text="Command List" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,215,0,0" FontSize="15"/>
            <Grid x:Name="gridCommand" Width="254" Margin="10,239,0,10" HorizontalAlignment="Left">
                <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="5" Margin="0,0,0,0" />
                <ComboBox x:Name="comboCommand" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Width="139" SelectionChanged="comboCommand_SelectionChanged" />
                <Button x:Name="buttonModelCommandImport" Margin="154,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="25" Content="Import" Click="buttonModelCommandImport_Click"/>
                <Button x:Name="buttonModelCommandExport" Margin="154,39,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="25" Content="Export" Click="buttonModelCommandExport_Click"/>
                <Button x:Name="buttonModelCommandClear" Margin="10,39,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="25" Content="Clear" Click="buttonModelCommandClear_Click" />
                <ListBox x:Name="listBoxCommand" SelectionMode="Extended" HorizontalAlignment="Center" Margin="0,69,0,10" Width="234" SelectionChanged="listBoxCommand_SelectionChanged" >
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Selected" Click="CopySelected_Click"/>
                            <MenuItem Header="Select All" Click="SelectAll_Click"/>
                            <MenuItem Header="Clear All" Click="ClearAll_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
            <Button x:Name="buttonTest" Margin="164,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Height="25" Content="Test" Click="buttonTest_Click" Visibility="Hidden"/>

            <TextBlock x:Name="textBlockVersion" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="165,215,0,0" FontSize="15" Width="87"/>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="404*"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="checkBoxAlwaysOnTop" Content="Always On Top" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" Click="checkBoxAlwaysOnTop_Checked"/>

            <TabControl Margin="10,10,10,10" Grid.RowSpan="2">
                <TabItem Header="Measure">
                    <Frame  Source="Pages/Measure.xaml" Margin="0"/>
                </TabItem>
                <TabItem Header="Factory" x:Name="TabItemFactory" IsEnabled="False">
                    <Frame x:Name="FrameFactory" Source="Pages/Factory.xaml"/>
                </TabItem>
                <TabItem Header="ALC" x:Name="TabItemALC" IsEnabled="False">
                    <Frame x:Name="ALC" Source="Pages/ALC.xaml"/>
                </TabItem>
                <TabItem Header="Calibration"  x:Name="TabItemCalibration" IsEnabled="False">
                    <Frame x:Name="Calibration" Source="Pages/Calibration.xaml"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
