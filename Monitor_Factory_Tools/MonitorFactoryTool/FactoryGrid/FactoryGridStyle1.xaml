<local:BaseGridStyle x:Class="MonitorFactoryTool.FactoryGrid.FactoryGridStyle1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MonitorFactoryTool.FactoryGrid"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="350">
    <Grid  ShowGridLines="True" Background ="Transparent" >
        <Label x:Name="label" Content="Power" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <ComboBox x:Name="combobox" Margin="110,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"  Width="80"  >
            <ComboBoxItem Content="00"/>
            <ComboBoxItem Content="01"/>
        </ComboBox>
    </Grid>
</local:BaseGridStyle>
