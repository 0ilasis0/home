<local:BaseGridStyle x:Class="MonitorFactoryTool.FactoryGrid.FactoryGridStyle2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MonitorFactoryTool.FactoryGrid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid ShowGridLines="True" Background ="Transparent">
        <Label x:Name="label" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox x:Name="textbox" Text="100"  Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="110,0,0,0" TextChanged="textbox_TextChanged" />
        <Button x:Name="buttonDown" Margin="180,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="20" Content="-" Click="buttonDown_Click"/>
        <Button x:Name="buttonUp" Margin="220,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="20" Content="+" Click="buttonUp_Click"/>
    </Grid>
</local:BaseGridStyle>
