<local:BaseGridStyle x:Class="MonitorFactoryTool.FactoryGrid.FactoryGridStyle3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MonitorFactoryTool.FactoryGrid"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid ShowGridLines="True" Background ="Transparent">
        <Label x:Name="label"  HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="combobox" Margin="110,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="80" Height="20" SelectionChanged="combobox_SelectionChanged" >
            <ComboBoxItem Content="Red"/>
            <ComboBoxItem Content="Blue"/>
            <ComboBoxItem Content="Green"/>
        </ComboBox>
        <TextBox x:Name="textbox" Text="255" FontWeight="Bold" Height="20" VerticalAlignment="Center" Margin="200,0,0,0" HorizontalAlignment="Left" Width="45" InputMethod.IsInputMethodEnabled="False" TextChanged="textbox_TextChanged"/>
        <Button x:Name="buttonDown" Margin="260,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="24" Height="20" Content="-" Click="buttonDown_Click"/>
        <Button x:Name="buttonUp" Margin="301,0,0,0" Height="20" Content="+" HorizontalAlignment="Left" VerticalAlignment="Center" Width="24" Click="buttonUp_Click"/>
    </Grid>
</local:BaseGridStyle>
